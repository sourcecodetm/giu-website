/** GIU public website lead collector. Bound to the GIU Website Lead Register Google Sheet. */
const NOTIFY_EMAIL = 'gasisus@eszw.tech';
const PILOT_SHEET = 'Pilot Leads';
const INVESTOR_SHEET = 'Investor Partner Leads';
function doGet(){return json_({ok:true,service:'GIU Lead Collector'});}
function doPost(e){try{const p=parsePayload_(e);if(p.website)return json_({ok:true,ignored:true});const ss=SpreadsheetApp.getActiveSpreadsheet();const type=p.type||p.form_type||(p.interest||p.typeOfInterest?'investor':'pilot');if(type==='investor'||type==='partner'||type==='investor_partner')saveInvestorLead_(ss,p);else savePilotLead_(ss,p);return json_({ok:true});}catch(err){console.error(err);return json_({ok:false,error:String(err)});}}
function savePilotLead_(ss,p){const sh=getOrCreateSheet_(ss,PILOT_SHEET,['Timestamp','Name','Phone','Email','Area / Suburb','Current Cooking Fuel','Household Size','Tank Size','GIU Service Interested In','Consent']);sh.appendRow([new Date(p.submitted_at||new Date()),p.name||'',p.phone||'',p.email||'',p.area||p.areaSuburb||'',p.currentCookingFuel||p.fuel||'',p.householdSize||p.household||p.household_size||'',p.tankSize||p.tank_size||p.tank||'',p.service||p.serviceInterest||'',p.consent||'']);sendNotification_('New GIU Pilot registration',['Name: '+(p.name||''),'Phone: '+(p.phone||''),'Email: '+(p.email||''),'Area: '+(p.area||p.areaSuburb||''),'Fuel: '+(p.currentCookingFuel||p.fuel||''),'Household: '+(p.householdSize||p.household||p.household_size||''),'Tank size: '+(p.tankSize||p.tank_size||p.tank||''),'Service: '+(p.service||p.serviceInterest||'')].join('\n'));}
function saveInvestorLead_(ss,p){const sh=getOrCreateSheet_(ss,INVESTOR_SHEET,['Timestamp','Name','Organisation','Email','Phone','Type of Interest','Message']);sh.appendRow([new Date(p.submitted_at||new Date()),p.name||'',p.organisation||p.organization||'',p.email||'',p.phone||'',p.interest||p.typeOfInterest||'',p.message||'']);sendNotification_('New GIU Investor / Partner enquiry',['Name: '+(p.name||''),'Organisation: '+(p.organisation||p.organization||''),'Email: '+(p.email||''),'Phone: '+(p.phone||''),'Interest: '+(p.interest||p.typeOfInterest||''),'Message: '+(p.message||'')].join('\n'));}
function parsePayload_(e){if(e&&e.postData&&e.postData.contents){const raw=e.postData.contents;try{return JSON.parse(raw);}catch(_){} }return(e&&e.parameter)?e.parameter:{};}
function getOrCreateSheet_(ss,name,headers){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(headers);sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight('bold');}return sh;}
function sendNotification_(subject,body){try{MailApp.sendEmail(NOTIFY_EMAIL,subject,body);}catch(err){console.error('Notification email failed: '+err);}}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
